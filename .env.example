# Copy this file to .env.local and fill in the values.
# The same names go into Vercel: Project -> Settings -> Environment Variables.

# Supabase -> Project Settings -> API
VITE_SUPABASE_URL=https://xxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...

# Your WhatsApp number, digits only with country code (shows the WhatsApp buttons)
VITE_WHATSAPP=2567XXXXXXXX

# Optional: send replies straight from the dashboard (Vercel only, not needed locally)
RESEND_API_KEY=
MAIL_FROM=Nova Works <hello@novaworks.co.ug>
MAIL_REPLY_TO=
